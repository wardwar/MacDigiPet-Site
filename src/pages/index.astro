---
import Base from '../layouts/Base.astro';
import { app, links } from '../config';
const shots = [
  ['/img/status-panel.png', 'Care & status', 'Check in on your partner, tend to its needs, and watch it grow.'],
  ['/img/status-evolution.png', 'Evolution', 'Explore the paths your care can open.'],
  ['/img/notch-controls.png', 'At your fingertips', 'Find your partner and village from the Mac menu bar.'],
  ['/img/battle-notch.png', 'Battle commands', 'Fights open in the notch: watch HP and MP, then pick Auto or one of three techniques.', 'centered'],
  ['/img/evolution-phases.png', 'Growing up', 'Experience evolution with cues inspired by the original game.'],
  ['/img/music-menu.jpg', 'Original DW1 music', 'Turn on area themes from the menu bar, pick a track or let them rotate, and set the volume.'],
];
// Filmed on a real MacBook. Width and height reserve each clip's real shape, so phones can show it uncropped.
const clips = [
  ['going-home', 720, 720, 'Nature calls', '“I have to get back to the village!” Your partner heads home when it needs the toilet.'],
  ['coding-buddy', 720, 466, 'It lives where you work', 'Your partner keeps you company while you code.'],
  ['hatch-punimon', 720, 900, 'Choose your egg', 'Pick a Digi-Egg in the park and watch it hatch.'],
  ['battle-megadramon-greymon', 720, 720, 'Battles on your desktop', 'Megadramon and Greymon trade blows with original DW1 moves.'],
  ['battle-notch-command', 720, 758, 'You call the shots', 'Pick Auto or a technique in the notch, then watch it land. HP and MP update live.'],
];
---
<Base description="A free Digimon World 1-inspired desktop companion for Mac. Free now, free forever, supported by its community.">
  <section class="hero"><div class="wrap">
    <span class="badge">{app.version} · macOS</span>
    <h1>Your Digimon partner,<br />on your Mac desktop.</h1>
    <p>Raise a partner, discover its evolution and make a village your own. A little piece of the Digital World, right on your Mac.</p>
    <p class="free-promise"><strong>Free to play. Free forever.</strong> Made for fans, supported by fans.</p>
    <div class="row"><a class="btn" href={links.discord} target="_blank" rel="noopener noreferrer">Join the Discord ↗</a><a class="btn alt" href="#in-motion">See it in motion ↓</a></div>
    <p class="hero-note">Beta testing happens in Discord · No release date announced</p>
  </div></section>

  <section class="pad story-intro"><div class="wrap story-layout">
    <div><span class="eyebrow">A WORLD THAT LIVES WITH YOU</span><h2>From a tiny egg to a lifelong partner.</h2><p>Your Digimon lives on your desktop. Feed it, care for it and see how your choices shape its evolution.</p><p>When it’s time to rest, there’s a village waiting on a desktop of its own.</p><a href="/wallpaper">Explore the village wallpaper →</a></div>
    <figure class="story-image"><img src="/img/village-ready-macbook.jpg" alt="A MacBook showing the village at sunrise with four Digi-Eggs to choose from" loading="lazy" /><figcaption>Your village is ready · on a MacBook</figcaption></figure>
  </div></section>

  <section id="in-motion" class="pad"><div class="wrap">
    <div class="section-heading"><div><span class="eyebrow">ON A REAL MAC</span><h2>See it in motion.</h2></div><p>Filmed during development. Wallpapers, effects and balance may still change.</p></div>
    <div class="snapshot-grid">
      {clips.map(([name, width, height, title, desc]) => <figure class="snapshot"><div class="snapshot-image motion"><video width={width} height={height} data-src={`/media/${name}.mp4`} poster={`/media/${name}.jpg`} muted loop playsinline preload="none" aria-label={title}></video></div><figcaption><strong>{title}</strong><span>{desc}</span></figcaption></figure>)}
      <figure class="snapshot"><div class="snapshot-image motion"><img src="/img/partner-bench.jpg" width="832" height="1040" alt="A partner Digimon resting on the village bench at night" loading="lazy" /></div><figcaption><strong>Time to rest</strong><span>At night your partner settles down in the village.</span></figcaption></figure>
    </div>
  </div></section>

  <section id="look-inside" class="pad"><div class="wrap">
    <div class="section-heading"><div><span class="eyebrow">SNAPSHOTS FROM DEVELOPMENT</span><h2>A closer look inside.</h2></div><p>Real moments from MacDigiPet as it grows. The interface and features may change during development.</p></div>
    <div class="snapshot-grid">{shots.map(([src, title, desc, fit]) => <figure class="snapshot"><div class={`snapshot-image${fit ? ` ${fit}` : ''}`}><img src={src} alt={title} loading="lazy" /></div><figcaption><strong>{title}</strong><span>{desc}</span></figcaption></figure>)}</div>
  </div></section>

  <section class="pad"><div class="wrap detail-strip"><div><span class="eyebrow">DIGIMON WORLD 1</span><h2>Care. Explore. Evolve.</h2></div><p>122 available forms, four eggs, a village to call home and battles across your desktop. Your save stays on your Mac.</p><a href="/devlog">Follow development →</a></div></section>

  <section class="pad support-section"><div class="wrap support-panel">
    <div><span class="eyebrow">HELP THIS LITTLE WORLD GROW</span><h2>Made with care.<br />Shared for free.</h2></div>
    <div><p>MacDigiPet is free and will always be free. If you enjoy watching it grow, a small tip now and then helps cover the developer’s time, tools and test devices. No pressure at all.</p><div class="row"><a class="btn lg" href={links.kofi} target="_blank" rel="noopener noreferrer"><span class="heart" aria-hidden="true">♥</span>Support on Ko-fi ↗</a><a class="btn lg" href={links.saweria} target="_blank" rel="noopener noreferrer"><span class="heart" aria-hidden="true">♥</span>Support on Saweria ↗</a></div><p class="muted">Never required for access. Feedback, bug reports and sharing the project help just as much.</p><a href="/support">More ways to support →</a></div>
  </div></section>
  <section class="pad"><div class="wrap community-close"><div><span class="eyebrow">JOIN THE BETA</span><h2>Be there for the first builds.</h2><p>Beta testing is organised in Discord. Join to follow development, share your desktop, swap ideas with fellow fans and hear first when testing opens.</p><a href="/beta">How testing works →</a></div><a class="btn" href={links.discord} target="_blank" rel="noopener noreferrer">Join Discord ↗</a></div></section>
  <script>
    // Clips load and play only while on screen, keeping the first page load light.
    // Each clip is fetched once into memory so loops never go back to the network,
    // which otherwise flashes a blank frame on hosts that send no-cache.
    const clips = document.querySelectorAll<HTMLVideoElement>('#in-motion video');
    const load = (video: HTMLVideoElement) => {
      const url = video.dataset.src;
      if (!url || video.dataset.loading) return;
      video.dataset.loading = '1';
      fetch(url).then((r) => (r.ok ? r.blob() : Promise.reject())).then(
        (blob) => { video.src = URL.createObjectURL(blob); },
        () => { video.src = url; },
      ).then(() => { if (video.dataset.visible) video.play().catch(() => {}); });
    };
    const io = new IntersectionObserver((entries) => entries.forEach(({ target, isIntersecting }) => {
      const video = target as HTMLVideoElement;
      if (isIntersecting) { video.dataset.visible = '1'; load(video); video.play().catch(() => {}); }
      else { delete video.dataset.visible; video.pause(); }
    }), { threshold: 0.35 });
    clips.forEach((video) => io.observe(video));
  </script>
</Base>
